# Copia este archivo a  .streamlit/secrets.toml  (local) o pégalo en
# Streamlit Cloud → Settings → Secrets.  NUNCA subas secrets.toml a GitHub.
#
# Solo se necesitan para el modo "Real". El modo "Demo" no requiere nada.

# ── API de market data de Coril (renta variable BVL / internacional) ──
CORIL_API_BASE = "https://sab-dma-marketdata-services-qa.grupocoril.pe"
CORIL_API_AUTH = "Basic XXXXXXXXXXXXXXXX"   # header Authorization completo
CORIL_USER_ID  = "12345"                    # X-User-ID

# yfinance (renta fija y benchmark) no requiere credenciales.
